# DeepSeek API 配置
# 复制本文件为 .env.local，填入真实值，不要提交 .env.local

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# deepseek-v4-pro / deepseek-v4-flash 是 thinking 模型。
# 本项目需要稳定 JSON 输出，默认关闭 thinking，让最终 JSON 回到 message.content。
# 如需开启（不推荐用于结构化 JSON 任务），改为 enabled。
DEEPSEEK_THINKING=disabled

# 设为 false 可关闭 JSON mode（当模型不支持 response_format 时使用）
DEEPSEEK_JSON_MODE=true

# JSON 结果较长时可适当调大；v4-pro 建议 8192
DEEPSEEK_MAX_TOKENS=8192
